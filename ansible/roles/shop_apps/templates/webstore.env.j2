# Managed by Ansible (roles/shop_apps). Edit ansible/group_vars/all/main.yml instead.
# Mode 0600: contains secrets.

# --- Lab addressing ---
FRONTEND1_HOST={{ frontend1_fqdn }}
FRONTEND2_HOST={{ frontend2_fqdn }}
FRONTEND1_IP={{ frontend1_ip }}
FRONTEND2_IP={{ frontend2_ip }}
SHOP_VIP_DNS={{ shop_vip_dns }}
SHOP_VIP_IP={{ shop_vip_ip }}
GARB_D_HOST={{ ops_fqdn }}
GARB_D_IP={{ ops_ip }}

# --- Secrets (all = lab_password) ---
JWT_SECRET={{ lab_password }}
INTERNAL_TOKEN={{ lab_password }}
MARIADB_ROOT_PASSWORD={{ lab_password }}
MARIADB_PASSWORD={{ lab_password }}
MARIADB_SST_PASSWORD={{ lab_password }}
LDAP_MANAGER_PASSWORD={{ lab_password }}
LDAP_API_PASSWORD={{ lab_password }}
KEEPALIVED_PASS={{ lab_password[:8] }}
SYNTH_PASSWORD={{ lab_password }}
ADMIN_PASSWORD={{ lab_password }}

# --- Service URLs (containers on a shop host) ---
DATABASE_URL=mysql+pymysql://webstore:{{ lab_password | urlencode | replace('/', '%2F') }}@webstore-mariadb:3306/webstore
BACKEND_URL=http://webstore-backend:8001
{% if peer_ip is defined %}
PEER_BACKEND_URL=http://{{ peer_ip }}:8001
LDAP_URL=ldap://{{ node_ip }}:389
LDAP_PEER_URL=ldap://{{ peer_ip }}:389
{% else %}
PEER_BACKEND_URL=
LDAP_URL=
LDAP_PEER_URL=
{% endif %}
LDAP_BASE_DN={{ ldap_suffix }}
LDAP_PEOPLE_OU={{ ldap_people_ou }}
LDAP_SERVICE_DN={{ ldap_service_dn }}
JWT_EXPIRE_MINUTES={{ jwt_expire_minutes }}

# --- Admin ---
ADMIN_USERS={{ admin_users | join(',') }}
RESERVED_USERNAMES={{ reserved_usernames | join(',') }}

# --- synth-users (demo-vm) ---
STORE_BASE_URL={{ shop_url }}
SYNTH_COUNT=100
SYNTH_MIN_SEC=15
SYNTH_MAX_SEC=45
