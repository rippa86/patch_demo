# /etc/webstore/monitoring.env on demo-vm (mode 0600). Read by webstore-exporter.
NODES=web-frontend1=10.10.4.115,web-frontend2=10.10.4.116
HAPROXY_STATS_URL=http://127.0.0.1:8404/;csv
# MariaDB user created by monitoring/create-monitor-user.sh on web-frontend1.
MONITOR_DB_USER=monitor
MONITOR_DB_PASSWORD=change-me-lab-monitor
# Same service account the shop APIs use (uid=api).
LDAP_SERVICE_DN=uid=api,ou=Services,dc=webstore,dc=local
LDAP_API_PASSWORD=change-me-lab-api-bind
LDAP_PEOPLE_OU=ou=People,dc=webstore,dc=local
